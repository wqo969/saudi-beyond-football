# JEDDAH MORNING — copy to .env.local (never commit real values).
# All values are free/self-generated. No paid service keys belong here.

# --- Access (required in production; dev falls back to demo-reader / demo-admin) ---
JM_READER_PASSWORD=
JM_ADMIN_PASSWORD=
# At least 32 random chars, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JM_SESSION_SECRET=

# --- Content backend: local (default) | supabase (phase 2, not implemented yet) ---
JM_CONTENT_BACKEND=local

# --- Phase 2: Supabase Free (leave empty until approved) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # server only — never NEXT_PUBLIC_

# --- Scheduled publishing hook (disabled when empty) ---
JM_CRON_SECRET=

# --- Web Push scaffold (disabled) ---
JM_PUSH_ENABLED=false
# NEXT_PUBLIC_JM_VAPID_PUBLIC_KEY=
# JM_VAPID_PRIVATE_KEY=

# --- Local testing only ---
# NEXT_PUBLIC_JM_SW_IN_DEV=1       # register the service worker under `next dev`
# JM_INSECURE_COOKIES=true         # allow login over plain http on `next start` (e2e tests only)
